{
  "name": "motorismo",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --filter=web",
    "build": "turbo run build",
    "start": "turbo run start --filter=web",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "ts:check": "turbo run ts:check",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e --filter=web",
    "format": "prettier --write .",
    "db:start": "pnpm --filter @motorismo/supabase sandbox:start",
    "db:stop": "pnpm --filter @motorismo/supabase sandbox:stop",
    "db:reset": "pnpm --filter @motorismo/supabase sandbox:reset",
    "db:test": "pnpm --filter @motorismo/supabase sandbox:test",
    "db:types": "pnpm --filter @motorismo/supabase types:gen",
    "prepare": "husky",
    "nuke": "rm -rf node_modules apps/*/node_modules packages/*/node_modules && pnpm install"
  },
  "prettier": "@motorismo/prettier-config",
  "engines": {
    "node": ">=24",
    "pnpm": "12.15.0"
  },
  "packageManager": "pnpm@12.15.0",
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@motorismo/prettier-config": "workspace:*",
    "husky": "^9.1.7",
    "prettier": "catalog:",
    "turbo": "^2.11.13",
    "typescript": "catalog:"
  }
}
