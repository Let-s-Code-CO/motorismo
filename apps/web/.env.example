# Copy to .env.local. Local values come from `pnpm --filter @motorismo/supabase sandbox:status`.
# In Vercel, set them per environment (Production / Preview / Development).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Server-only. Used for invitations and account bans. Never prefix it with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=
# Optional: base URL for email/OAuth links. Defaults to https://$VERCEL_URL, then localhost:3000.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
